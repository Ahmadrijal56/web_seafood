{
  "name": "syauqi-seafood",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @sfs/web dev",
    "dev:cms": "pnpm --filter @sfs/cms dev",
    "assets": "pnpm --filter @sfs/seed assets",
